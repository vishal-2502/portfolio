# Optional public-facing profile settings.
# Vite exposes only variables prefixed with VITE_ to browser code.
# Do not put passwords, API secrets, private tokens, or credentials here.

VITE_SITE_URL=https://your-domain.example
VITE_CONTACT_EMAIL=your.email@example.com
VITE_CONTACT_PHONE=+91-00000-00000
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-profile/
VITE_GITHUB_URL=https://github.com/your-username
VITE_RESUME_URL=
VITE_LOCATION=Pune, India
VITE_SHOW_EMAIL=true
